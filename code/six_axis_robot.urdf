<?xml version="1.0"?>
<robot name="six_axis_robot">

    <!-- Définition des couleurs et matériaux -->
    <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
    </material>
    
    <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
    </material>

    <!-- Base -->
    <link name="base"/>
    
    <!-- Articulation 1 : Rotation du socle -->
    <link name="link1">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="joint1" type="revolute">
        <parent link="base"/>
        <child link="link1"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    </joint>

    <!-- Articulation 2 : Pivot vertical -->
    <link name="link2">
        <visual>
            <geometry>
                <box size="0.1 0.3 0.5"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <!-- Articulation 3 : Rotation du bras intermédiaire -->
    <link name="link3">
        <visual>
            <geometry>
                <box size="0.1 0.25 0.4"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <limit lower="-2.0" upper="2.0" effort="10" velocity="1"/>
    </joint>

    <!-- Articulation 4 : Rotation du poignet -->
    <link name="link4">
        <visual>
            <geometry>
                <box size="0.08 0.2 0.3"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

    <joint name="joint4" type="revolute">
        <parent link="link3"/>
        <child link="link4"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.3" rpy="0 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <!-- Articulation 5 : Rotation de l’axe final -->
    <link name="link5">
        <visual>
            <geometry>
                <box size="0.06 0.15 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="joint5" type="revolute">
        <parent link="link4"/>
        <child link="link5"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <!-- Articulation 6 : Rotation de la pince -->
    <link name="link6">
        <visual>
            <geometry>
                <box size="0.05 0.1 0.1"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

    <joint name="joint6" type="revolute">
        <parent link="link5"/>
        <child link="link6"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
    </joint>

</robot>
